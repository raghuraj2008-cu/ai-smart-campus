# ==========================================
# 1. Project Core Configuration
# ==========================================
PROJECT_NAME="AI Smart Campus Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# ==========================================
# 2. Database (PostgreSQL) Configuration
# ==========================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_campus
# Full connection string for SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_campus

# ==========================================
# 3. Redis Cache & WebSockets Pub/Sub
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
# Full connection URL for Redis
REDIS_URL=redis://redis:6379/0

# ==========================================
# 4. Security & JWT Token Configuration
# ==========================================
SECRET_KEY=supersecretjwtkeychangeinproduction987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# 5. AI Triage & LLM Configuration
# ==========================================
GROQ_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ==========================================
# 6. SMTP & Notification Settings
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@campus.edu
EMAILS_FROM_NAME="Smart Campus Support"